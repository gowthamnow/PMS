# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://pms_user:pms_password@localhost:5432/pms_db

# Security & JWT Authentication
SECRET_KEY=change_this_to_a_super_secret_cryptographically_secure_random_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend URL (CORS configuration)
FRONTEND_URL=http://localhost:3000

# File Storage Configuration
ATTACHMENT_STORAGE_PATH=/data/attachments
ATTACHMENT_MAX_FILE_SIZE_MB=25
ATTACHMENT_QUOTA_GB=2

# Gitea Integration
GITEA_BASE_URL=http://localhost:3001
GITEA_ADMIN_TOKEN=your_gitea_admin_token_here

# First Admin User Bootstrap Credentials
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=AdminSecurePassword123!
FIRST_ADMIN_USERNAME=admin
